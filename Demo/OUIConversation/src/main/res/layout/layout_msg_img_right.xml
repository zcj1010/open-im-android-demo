<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <io.openim.android.ouicore.widget.AvatarImage
            android:id="@+id/avatar2"
            android:layout_width="@dimen/dp_38"
            android:layout_height="@dimen/dp_38"
            android:layout_alignParentEnd="true"
            android:src="@mipmap/ic_my_friend" />

        <TextView
            android:id="@+id/readVanishNum2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_toStartOf="@id/sendState2"
            android:textColor="#ff5496eb"
            android:textSize="@dimen/txt_12" />

        <io.openim.android.ouiconversation.widget.SendStateView
            android:id="@+id/sendState2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/contentGroup2" />

        <LinearLayout
            android:id="@+id/contentGroup2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/txt_8"
            android:layout_toStartOf="@id/avatar2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nickName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="3dp"
                android:textColor="#ff666666"
                android:textSize="12sp"
                android:visibility="gone" />

            <!--            android:background="@drawable/sty_radius_unright_30"-->
            <!--            android:padding="@dimen/dp_4"-->
            <ImageView
                android:id="@+id/content2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_chat_photo" />

        </LinearLayout>


    </RelativeLayout>
</FrameLayout>
