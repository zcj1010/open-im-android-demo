<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="ChatVM"
            type="io.openim.android.ouiconversation.vm.ChatVM" />
    </data>
    <!--    android:tag="layout/layout_input_cote_0"-->
    <io.openim.android.ouicore.widget.InterceptLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_16"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:background="@drawable/im_chat_input_bg"
                android:gravity="center_vertical"
                android:minHeight="@dimen/dp_40"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/keyboardOrVoiceIv"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_marginStart="@dimen/dp_8"
                    android:src="@drawable/im_input_voice"
                    android:tag="@string/voice_tag" />

                <LinearLayout
                    android:id="@+id/inputLy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_8">

                        <io.openim.android.ouiconversation.widget.TailInputEditText
                            android:id="@+id/chatInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="发消息"
                            android:imeOptions="actionSend"
                            android:maxHeight="@dimen/dp_90"
                            android:minHeight="@dimen/dp_40"
                            android:text="@={ChatVM.inputMsg}"
                            android:textColor="@color/txt_theme"
                            android:textColorHint="@color/txt_auxiliary"
                            android:textSize="@dimen/txt_13" />

                        <TextView
                            android:id="@+id/voiceInput"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_40"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="按住说话"
                            android:textColor="@color/txt_main"
                            android:textSize="@dimen/txt_13"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/notice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/start_group_mute"
                            android:textColor="@color/txt_auxiliary"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/replyLy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/sty_radius_4_white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/replyContent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textColor="#ff999999"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/cancelReply"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:src="@mipmap/ic_close" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/emojiOrKeyboardIv"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/im_input_emoji"
                    android:tag="@string/emoji_tag" />

                <ImageView
                    android:id="@+id/chatMoreOrSend"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_marginHorizontal="@dimen/dp_8"
                    android:src="@drawable/im_input_more"
                    android:tag="@string/more_tag" />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/highTips"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/theme_bg"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/quited_tips"
                    android:textColor="#ff8e9ab0"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="6dp"
                    android:layout_toLeftOf="@id/tips"
                    android:src="@mipmap/ic_ex_mark" />
            </RelativeLayout>
        </LinearLayout>


        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </io.openim.android.ouicore.widget.InterceptLinearLayout>

</layout>

